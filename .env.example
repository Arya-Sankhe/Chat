APP_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0

# Additional comma-separated origins for local Capacitor development.
# Production defaults include klui.ai, the legacy klui.tech origins, and the
# packaged Android origin https://localhost.
MOBILE_ALLOWED_ORIGINS=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: speak Kokoro (podcasts, AI tutor) directly from DeepInfra for low-latency voice.
DEEPINFRA_API_KEY=
# Must cover Krea 2 Medium Turbo's fixed $0.015 cost for one 1K image.
ILLUSTRATION_RESERVATION_CREDITS=0.25
# Speech-to-text uses the same OpenRouter key (microsoft/mai-transcribe-2).

# Desktop OAuth facade, server-funded inference, and independent kill switches.
# Register the provider clients in Supabase OAuth Server staging first.
DESKTOP_OAUTH_ENABLED=false
DESKTOP_CHAT_ENABLED=false
DESKTOP_STT_ENABLED=false
# Canonical profiles.id UUIDs. Use * only for an intentional all-paid-plan rollout.
DESKTOP_BETA_ACCOUNT_IDS=
SUPABASE_OAUTH_DESKTOP_WINDOWS_CLIENT_ID=
SUPABASE_OAUTH_DESKTOP_MACOS_CLIENT_ID=
DESKTOP_PRIVACY_POLICY_VERSION=2026-08-11
DESKTOP_MAX_COMPLETION_TOKENS=8192
# Hard provider-routing ceilings used to prove the per-iteration reservation.
# The beta model currently advertises a 1,050,000-token input context.
DESKTOP_MAX_INPUT_TOKENS=1050000
DESKTOP_MAX_PROMPT_PRICE_PER_MILLION=0.20
DESKTOP_MAX_COMPLETION_PRICE_PER_MILLION=1.20
# Must cover the maximum possible provider cost of one accepted desktop iteration.
DESKTOP_CHAT_RESERVATION_CREDITS=0.25
DESKTOP_MINIMUM_WINDOWS_VERSION=0.1.0
DESKTOP_LATEST_WINDOWS_VERSION=0.1.0
DESKTOP_WINDOWS_DOWNLOAD_URL=https://klui.ai/download/windows
# Production host directory for versioned Windows installers and latest.json.
WINDOWS_DOWNLOADS_DIR=./public/downloads/windows

# legacy keeps the existing meter; observe compares predictions; enforce enables
# atomic reserve/submit/settle. Desktop inference fails closed unless enforce.
API_USAGE_METERING_MODE=legacy

# OpenWeather current conditions + 5-day / 3-hour forecast.
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org
OPENWEATHER_TIMEOUT_MS=8000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
# Alias if GOOGLE_CLIENT_ID is unset.
SUPABASE_GOOGLE_CLIENT_ID=

# Access (required: unset or any other value refuses to start)
# testing: every signed-in user gets TEST_PLAN_ID for local/MVP testing.
# subscription: only users with an active approved subscription can chat.
ACCESS_MODE=testing
TEST_PLAN_ID=pro

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_UPLOAD_EXPIRES_SECONDS=300
R2_READ_EXPIRES_SECONDS=900
# Shared server-validation and browser-downscale limit (10 MiB).
R2_MAX_IMAGE_BYTES=10485760

# Browser-accessible ONLYOFFICE Docs URL. Use HTTPS in production.
ONLYOFFICE_PUBLIC_URL=http://localhost:8082
ONLYOFFICE_JWT_SECRET=change-this-onlyoffice-secret
# docker-compose sets JWT_HEADER=AuthorizationJwt so R2 signed downloads work.

# Daily VPS cleanup for uploaded files that were never attached to a chat.
STORAGE_CLEANUP_GRACE_DAYS=7
STORAGE_CLEANUP_PENDING_MINUTES=30
STORAGE_CLEANUP_BATCH_SIZE=100

# ─── Conversation context ──────────────────────────────────────────
# At ~180k estimated tokens, older turns become one stored rolling summary
# (reused and extended on later turns), the recent 80k stay verbatim, and
# 32k is reserved for the response and tool context.
CONTEXT_MAX_TOKENS=256000
CONTEXT_COMPACT_AT_TOKENS=180000
CONTEXT_KEEP_RECENT_TOKENS=80000
CONTEXT_RESERVE_TOKENS=32000
CONTEXT_SUMMARY_MAX_TOKENS=4000
# A model call with no answer this long after the request (headers or reasoning), or silent this long
# mid-answer (MODEL_ANSWER_IDLE_MS), is retried once with the same request.
MODEL_ANSWER_STALL_MS=240000
MODEL_ANSWER_IDLE_MS=120000

# ─── Document tools ────────────────────────────────────────────────
DOCUMENTS_ENABLED=true
DOCUMENT_MAX_FILE_BYTES=157286400
DOCUMENT_MAX_FILES_PER_MESSAGE=5
DOCUMENT_MAX_TOTAL_BYTES_PER_MESSAGE=157286400
DOCUMENT_MAX_PDF_PAGES=150
DOCUMENT_MAX_XLSX_SHEETS=25
DOCUMENT_MAX_XLSX_CELLS=250000
DOCUMENT_MAX_CSV_ROWS=100000
DOCUMENT_MAX_CSV_COLUMNS=100

# ─── Dojo audio sources (transcriber service) ─────────────────────
# Uploaded/recorded lectures are transcribed on this server by the transcriber
# container (Parakeet TDT 0.6B v2 int8). Only a ~22 MB/hour AAC copy is kept.
STUDY_AUDIO_ENABLED=true
STUDY_AUDIO_MAX_UPLOAD_BYTES=314572800
STUDY_AUDIO_MAX_SECONDS=14400
STUDY_AUDIO_MAX_ACTIVE_PER_USER=5
# Transcriber container: threads per job and the soft memory ceiling for one job
# (the container's hard cap is 3 GB in docker-compose.yml).
TRANSCRIBE_THREADS=4
TRANSCRIBE_CHILD_MAX_RSS_MB=2600
# Which queue this machine's app writes to and its transcriber claims from. Production
# sets "production"; anything else (default "local") keeps a dev machine that shares the
# production database from ever taking production lectures, and vice versa.
TRANSCRIBE_QUEUE=local

# Project knowledge capacity (source file bytes, per project)
PLAN_LITE_MAX_PROJECT_BYTES=786432000
PLAN_PRO_MAX_PROJECT_BYTES=786432000
PLAN_MAX_MAX_PROJECT_BYTES=786432000
# Account file capacity (source attachment bytes, pending + uploaded)
PLAN_LITE_MAX_STORAGE_BYTES=786432000
PLAN_PRO_MAX_STORAGE_BYTES=2684354560
PLAN_MAX_MAX_STORAGE_BYTES=5368709120
DOCUMENT_MAX_TOOL_RESULT_CHARS=80000
DOCUMENT_MAX_TOOL_CALLS_PER_TURN=75
DOCUMENT_VISUAL_PAGE_DPI=110
# Scanned pages are OCR-rendered separately at this DPI, or their own scan resolution if lower (72-400).
DOCUMENT_OCR_DPI=144
DOCUMENT_VISUAL_MAX_PAGES_PER_TOOL=12
DOCUMENT_VISUAL_MAX_IMAGE_INPUTS_PER_TURN=12
# Every document is stored as pages (text + image; Word/PowerPoint via PDF) or spreadsheet rows.
# Documents go into the chat whole while they fit: every page's text, plus the image of pages
# with figures, scans, tables or maths. A document too long for that is listed with a page index
# and the pages matching the question; the model reads the rest with read_document.
# Page images per turn's document context, and what one costs the model in tokens:
DOCUMENT_MAX_CONTEXT_IMAGES=20
DOCUMENT_PAGE_IMAGE_TOKENS=1900
DOCUMENT_VISUAL_INLINE_IMAGES=true
DOCUMENT_VISUAL_INLINE_MAX_BYTES=2097152
DOCUMENT_VISUAL_INLINE_MAX_TOTAL_BYTES=12582912
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_WORKER_MAX_IDLE_SECONDS=10
DOCUMENT_WORKER_ERROR_BACKOFF_SECONDS=0.5
DOCUMENT_WORKER_MEMORY_LIMIT=3g
DOCUMENT_JOB_TIMEOUT_MS=120000
DOCUMENT_LEASE_HEARTBEAT_SECONDS=30
DOCUMENT_HTTP_MAX_ATTEMPTS=3
DOCUMENT_PDF_RENDER_WORKERS=2
DOCUMENT_PAGE_UPLOAD_WORKERS=4
DOCUMENT_TOOL_JOB_WAIT_MS=20000
# Match the app and document worker; production uses "production".
DOCUMENT_QUEUE=local
DOCUMENT_UPLOAD_EXPIRES_SECONDS=900
DOCUMENT_PREVIEW_MAX_PAGES=2
DOCUMENT_PREVIEW_TTL_DAYS=30

RESEARCH_ENABLED=true
RESEARCH_WORKER_CONCURRENCY=3
RESEARCH_WORKER_POLL_MS=5000
RESEARCH_WORKER_MAX_POLL_MS=10000
# local docker default. klui.ai must set production so laptop workers cannot claim those jobs.
RESEARCH_QUEUE=local
RESEARCH_LEASE_SECONDS=120
RESEARCH_MAX_RUN_MS=1200000
RESEARCH_FETCH_TIMEOUT_MS=12000
RESEARCH_FETCH_CONCURRENCY=3
RESEARCH_MAX_EXTRACTED_CHARS=50000
RESEARCH_MAX_PAGES=18
RESEARCH_MAX_ROUNDS=5
RESEARCH_MIN_ROUNDS=2
RESEARCH_MAX_EMPTY_ROUNDS=2
RESEARCH_MAX_URLS_PER_ROUND=4
RESEARCH_INITIAL_QUERIES=4
RESEARCH_FOLLOWUP_QUERIES=3
RESEARCH_SEARCH_RESULTS=10
RESEARCH_EXTRACT_MAX_TOKENS=5000
RESEARCH_SYNTHESIS_MAX_TOKENS=25000
RESEARCH_FINAL_MAX_TOKENS=100000
RESEARCH_MIN_SOURCES=3

STUDY_MAX_RUN_MS=600000
STUDY_INACTIVITY_MS=30000

PLAN_LITE_PRICE_LABEL=10 AED / month
PLAN_LITE_AMOUNT_AED=10
PLAN_LITE_MONTHLY_API_CREDITS=1.36
PLAN_LITE_MAX_IMAGES_PER_MESSAGE=4
PLAN_LITE_MAX_DOCUMENTS_PER_MESSAGE=5
PLAN_LITE_MAX_DOCUMENT_FILE_BYTES=157286400
PLAN_LITE_MAX_DOCUMENT_BYTES_PER_MESSAGE=157286400
PLAN_LITE_MAX_DOCUMENT_PAGES=150
PLAN_LITE_ZIINA_PAYMENT_URL=
PLAN_LITE_ZIINA_QR_IMAGE_URL=

PLAN_PRO_PRICE_LABEL=30 AED / month
PLAN_PRO_AMOUNT_AED=30
PLAN_PRO_MONTHLY_API_CREDITS=4.08
PLAN_PRO_MAX_IMAGES_PER_MESSAGE=4
PLAN_PRO_MAX_DOCUMENTS_PER_MESSAGE=5
PLAN_PRO_MAX_DOCUMENT_FILE_BYTES=157286400
PLAN_PRO_MAX_DOCUMENT_BYTES_PER_MESSAGE=157286400
PLAN_PRO_MAX_DOCUMENT_PAGES=150
PLAN_PRO_ZIINA_PAYMENT_URL=
PLAN_PRO_ZIINA_QR_IMAGE_URL=

PLAN_MAX_PRICE_LABEL=50 AED / month
PLAN_MAX_AMOUNT_AED=50
PLAN_MAX_MONTHLY_API_CREDITS=8.16
PLAN_MAX_MAX_IMAGES_PER_MESSAGE=4
PLAN_MAX_MAX_DOCUMENTS_PER_MESSAGE=5
PLAN_MAX_MAX_DOCUMENT_FILE_BYTES=157286400
PLAN_MAX_MAX_DOCUMENT_BYTES_PER_MESSAGE=157286400
PLAN_MAX_MAX_DOCUMENT_PAGES=150
PLAN_MAX_ZIINA_PAYMENT_URL=
PLAN_MAX_ZIINA_QR_IMAGE_URL=

# Apply the harden_mamo_billing and mamo_first_month_coupons migrations before enabling checkout.
# See docs/MAMO_SANDBOX.md for verified sandbox results and production cutover.
# Mamo Pay. Default base is production https://business.mamopay.com/manage_api/v1
# MAMO_SANDBOX=true uses https://sandbox.dev.business.mamopay.com/manage_api/v1
# MAMO_WEBHOOK_AUTH is the webhook Authorization header (max 50). Register the
# webhook yourself at POST /webhooks for payment.succeeded, payment.failed,
# payment.card_verified, payment.refunded, subscription.succeeded, subscription.failed.
MAMO_API_KEY=
MAMO_SANDBOX=true
MAMO_API_BASE=
MAMO_WEBHOOK_AUTH=
# First-month coupons as CODE:percent, e.g. FIRST50:50,FIRSTFREE:100. Empty disables coupons.
MAMO_COUPONS=
# Sandbox only: Mamo "test" schedules renew within minutes so renewals can be observed.
MAMO_TEST_SCHEDULE=false
# Customers pay Mamo's processing fee on top of the plan price, so Klui nets the full price.
# Defaults: Growth-plan international card rate 3.4% + AED 1, plus 5% VAT on the fee.
# Use 2.7 / 0.8 on Mamo Premium; set both rate values to 0 to absorb the fee instead.
MAMO_FEE_PERCENT=3.4
MAMO_FEE_FIXED_AED=1
MAMO_FEE_VAT_PERCENT=5

# ─── Speech ────────────────────────────────────────────────────────
# Self-hosted Pocket TTS workers (ops/pocket-tts), comma-separated. Voice mode and tutor calls use
# them first and fall back to Kokoro when both are busy. docker-compose.yml points this at its
# pocket-tts-1/2 services; set it to an empty value to use Kokoro only.
# POCKET_TTS_URLS=http://pocket-tts-1:8000,http://pocket-tts-2:8000

# ─── Web search ────────────────────────────────────────────────────
# Primary: free hosted TinyFish Search API (30 requests/minute per key). The
# primary is tried first and each additional key is retried in order before Brave.
# Deep page reads go through read_url (TinyFetch, then Jina Reader).
# Search only; Klui does not call TinyFish Agent, Fetch, or Browser APIs.
TINYFISH_API_KEY=
TINYFISH_API_KEY_2=
TINYFISH_API_KEY_3=

# Self-hosted Jina Reader (ghcr.io/jina-ai/reader:oss) for read_url. When set,
# page reads go through this private service first and fall back to the hosted
# https://r.jina.ai on timeout/blocked/server error. Leave empty to use hosted only.
JINA_READER_BASE_URL=http://jina-reader:8081
JINA_READER_FALLBACK_URL=https://r.jina.ai

# Fallback: Jina Search Foundation (s.jina.ai) — one call returns search
JINA_API_KEY=
JINA_SEARCH_ENGINE=direct           # direct (fast) | browser (JS-rendered)

# Fallback: Brave LLM Context API. $5/1k requests, $5/mo free credit.
BRAVE_SEARCH_API_KEY=

# Toggle behaviour. Users can still flip Auto/Off in the UI; this is the
# server-wide default for new users + sessions.
WEBSEARCH_DEFAULT_MODE=auto         # auto | off
WEBSEARCH_PRIMARY_PROVIDER=tinyfish # tinyfish | jina | brave
WEBSEARCH_MAX_RESULTS=5
WEBSEARCH_PAGE_CONTENT_CHARS=15000
WEBSEARCH_TOTAL_CONTEXT_CHARS=45000
WEBSEARCH_FETCH_TIMEOUT_MS=20000
# Runaway stop, not a budget: the model searches as much as it needs; this only ends a loop
# stuck calling tools. Each loop (chat turn, or a writer/editor call inside it) counts separately.
WEBSEARCH_MAX_TOOL_CALLS_PER_TURN=75
WEBSEARCH_DENY_DOMAINS=
# Comma-separated hostnames added on top of the built-in adult deny list.
